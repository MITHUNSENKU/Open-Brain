bel>\n            <input type=\"password\" id=\"password\" name=\"password\" required>\n            <button type=\"submit\">Verify mobile number</button>\n        </form>\n        <div class=\"signin-link\">\n            Already have an account? <a href=\"/login.html\">Sign in</a>\n        </div>\n    </div>\n</body>\n</html>"}
