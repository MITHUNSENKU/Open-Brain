[2026-05-17T05:58:24.542Z] [Tool #2] write_file args={"path":"mit/server.js","content":"const express = require('express');\nconst fs = require('fs');\nconst path = require('path');\nconst bodyParser = require('body-parser');\n\nconst app = express();\nconst PORT = 8082;\nconst CSV_FILE = path.join(__dirname, 'users.csv');\n\napp.use(bodyParser.urlencoded({ extended: true }));\napp.use(express.static(__dirname));\n\nif (!fs.existsSync(CSV_FILE)) {\n    fs.writeFileSync(CSV_FILE, 'username,password\\n');\n}\n\napp.post('/register', (req, res) => {\n    const { username, password } = req.body;\n    if (!username || !password) return res.status(400).send('Missing credentials');\n    \n    fs.appendFileSync(CSV_FILE, `${username},${password}\\n`);\n    res.redirect('/login.html');\n});\n\napp.post('/login', (req, res) => {\n    const { username, password } = req.body;\n    const data = fs.readFileSync(CSV_FILE, 'utf8').split('\\n');\n    \n    const userExists = data.some(line => {\n        const [u, p] = line.split(',');\n        return u === username && p === password?.trim();\n    });\n\n    if (userExists) {\n        res.redirect('/index.html');\n    } else {\n        res.status(401).send('Invalid username or password. <a href=\"/login.html\">Try again</a>');\n    }\n});\n\napp.listen(PORT, () => console.log(`Server running on http://localhost:${PORT}`));"}
