r: #919191;\n            font-size: 0.85rem;\n            font-weight: bold;\n            margin: 0;\n        }\n        .name {\n            font-size: 1.2rem;\n            font-weight: bold;\n            color: #313131;\n            margin: 8px 0;\n        }\n        .types {\n            display: flex;\n            justify-content: center;\n            gap: 6px;\n        }\n        .type {\n            padding: 4px 12px;\n            border-radius: 20px;\n            font-size: 0.75rem;\n            color: white;\n            font-weight: bold;\n        }\n        .btn-container {\n            margin: 30px 0;\n            display: flex;\n            justify-content: center;\n            width: 100%;\n        }\n        #load-more-btn {\n            background-color: #ef5350;\n            color: white;\n            border: none;\n            padding: 12px 30px;\n            font-size: 1rem;\n            font-weight: bold;\n            border-radius: 25px;\n            cursor: pointer;\n            box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n            transition: background-color 0.2s, transform 0.1s;\n        }\n        #load-more-btn:hover {\n            background-color: #e53935;\n        }\n        #load-more-btn:active {\n            transform: scale(0.98);\n        }\n        #load-more-btn:disabled {\n            background-color: #b0bec5;\n            cursor: not-allowed;\n        }\n        .normal { background: #A8A77A; }\n        .fire { background: #EE8130; }\n        .water { background: #6390F0; }\n        .electric { background: #F7D02C; color: #333; }\n        .grass { background: #7AC74C; }\n        .ice { background: #96D9D6; color: #333; }\n        .fighting { background: #C22E28; }\n        .poison { background: #A33EA1; }\n        .ground { background: #E2BF65; }\n        .flying { background: #A98FF3; }\n        .psychic { background: #F95587; }\n        .bug { background: #A6B91A; }\n        .rock { background: #B6A136; }\n        .ghost { background: #735797; }\n        .dragon { background: #6F35FC; }\n        .dark { background: #705746; }\n        .steel { background: #B7B7CE; }\n        .fairy { background: #D685AD; }\n    </style>\n</head>\n<body>\n\n    <h1>Pokédex</h1>\n    <div class=\"search-container\">\n        <input type=\"text\" id=\"search-box\" placeholder=\"Search by name or ID...\">\n    </div>\n\n    <div class=\"grid\" id=\"pokedex-grid\"></div>\n\n    <div class=\"btn-container\">\n        <button id=\"load-more-btn\">Load More Pokémon</button>\n    </div>\n\n    <script>\n        const grid = document.getElementById('pokedex-grid');\n        const searchBox = document.getElementById('search-box');\n        const loadMoreBtn = document.getElementById('load-more-btn');\n        \n        let pokemonList = [];\n        let offset = 0;\n        const limit = 20;\n        let isSearching = false;\n\n        async function fetchPokemonBatch() {\n            loadMoreBtn.disabled = true;\n            loadMoreBtn.textContent = 'Loading...';\n            try {\n                const response = await fetch(`https://pokeapi.co/api/v2/pokemon?offset=${offset}&limit=${limit}`);\n                const data = await response.json();\n                \n                if (data.results.length === 0) {\n                    loadMoreBtn.style.display = 'none';\n                    return;\n                }\n\n                const promises = data.results.map(p => fetch(p.url).then(res => res.json()));\n                const newPokemon = await Promise.all(promises);\n                \n                pokemonList = [...pokemonList, ...newPokemon];\n                offset += limit;\n                \n                if (!isSearching) {\n                    render(pokemonList);\n                }\n                \n                loadMoreBtn.disabled = false;\n                loadMoreBtn.textContent = 'Load More Pokémon';\n            } catch (err) {\n                console.error(\"Error loading Pokédex data:\", err);\n                loadMoreBtn.disabled = false;\n                loadMoreBtn.textContent = 'Try Again';\n            }\n        }\n\n        function render(list) {\n            grid.innerHTML = list.map(p => {\n                const padId = p.id.toString().padStart(3, '0');\n                const types = p.types.map(t => `<span class=\"type ${t.type.name}\">${t.type.name}</span>`).join('');\n                const imgUrl = p.sprites.other['official-artwork'].front_default || p.sprites.front_default;\n                return `\n                    <div class=\"card\">\n                        <p class=\"id-label\">#${padId}</p>\n                        <img src=\"${imgUrl}\" alt=\"${p.name}\">\n                        <div class=\"name\">${p.name}</div>\n                        <div class=\"types\">${types}</div>\n                    </div>\n                `;\n            }).join('');\n        }\n\n        searchBox.addEventListener('input', (e) => {\n            const searchStr = e.target.value.toLowerCase().trim();\n            if (searchStr === '') {\n                isSearching = false;\n                loadMoreBtn.style.display = 'block';\n                render(pokemonList);\n            } else {\n                isSearching = true;\n                loadMoreBtn.style.display = 'none';\n                const filtered = pokemonList.filter(p => \n                    p.name.toLowerCase().includes(searchStr) || p.id.toString() === searchStr\n                );\n                render(filtered);\n            }\n        });\n\n        loadMoreBtn.addEventListener('click', fetchPokemonBatch);\n\n        // Initial load\n        fetchPokemonBatch();\n    </script>\n</body>\n</html>"}
